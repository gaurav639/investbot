# Investment Intelligence Agent - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Database (REQUIRED)
# =============================================================================
# PostgreSQL connection with pgvector extension enabled
# Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/investbot

# =============================================================================
# Groq API (REQUIRED)
# =============================================================================
# Get your API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use (default: qwen/qwen3.8-27b)
# Fallback chain: qwen/qwen3.8-27b → openai/gpt-oss-120b → openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.8-27b
